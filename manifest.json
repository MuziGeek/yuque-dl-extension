{
  "manifest_version": 3,
  "name": "语雀知识库下载 (yuque-dl)",
  "version": "0.1.0",
  "description": "一键把当前打开的语雀知识库/文档下载为本地 Markdown（含图片与附件），可自选保存目录。基于 yuque-dl。",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "语雀知识库下载",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "options_page": "options/options.html",
  "background": {
    "service_worker": "background/background.js",
    "type": "module"
  },
  "permissions": [
    "tabs",
    "cookies",
    "storage",
    "contextMenus",
    "declarativeNetRequest",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "https://*.yuque.com/*",
    "https://yuque.com/*",
    "https://cdn.nlark.com/*"
  ],
  "optional_host_permissions": ["https://*/*"],
  "web_accessible_resources": [
    {
      "resources": ["panel/panel.html"],
      "matches": ["https://*.yuque.com/*"]
    }
  ]
}
